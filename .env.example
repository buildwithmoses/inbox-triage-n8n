# Copy to .env (gitignored). Never commit real values.
N8N_URL=http://localhost:5678
# n8n UI -> Settings -> n8n API -> Create an API key
N8N_API_KEY=
# https://openrouter.ai/keys  (setup.mjs stores it as an n8n credential; it is never written to the workflow JSON)
OPENROUTER_API_KEY=
# Shared secret the approver sends as the X-Approval-Token header: openssl rand -hex 24
APPROVAL_TOKEN=
